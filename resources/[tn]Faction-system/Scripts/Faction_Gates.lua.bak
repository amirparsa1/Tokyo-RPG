local accSys = exports["[Phoenix]Account"] -- Code By ExMmD!
   

lifes = createObject ( 3095, 1254.9004, -1424.4004, 12 )
setElementData(lifes, "Lockesh", nil)
addCommandHandler("lift",
function(thePlayer, cmd)
	local x,y,z = getElementPosition(thePlayer)

	if tonumber(getElementData(accSys:getPlayerAcc(thePlayer), "pMember")) == 8 and tonumber(getElementData(accSys:getPlayerAcc(thePlayer), "pRank")) > 2 then
	 if getDistanceBetweenPoints3D(x,y,z,1254.28515625 ,-1424.2880859375 ,13.555365562439) < 30 then
		if getElementData(lifes,"Lockesh") == nil then
			moveObject ( lifes, 3000, 1254.9004, -1424.4004 ,21.1 )
	    	exports["notf"]:addNotification(thePlayer, "** Asansor Darhal Bala Amadan Ast! **" , 'info')
			setElementData(lifes, "Lockesh", true)
		elseif getElementData( lifes, "Lockesh" ) ==  true then
			moveObject ( lifes, 3000, 1254.9004, -1424.4004, 12 )
	    	exports["notf"]:addNotification(thePlayer, "** Asansor Darhal Paiin Amadan Ast! **" , 'info')
			setElementData(lifes, "Lockesh", nil)
		end
		end
	else
	    	exports["notf"]:addNotification(thePlayer, "** Mechanic Rank +2 Mitavanad In Gate Ro Chnage Konad! **" , 'error')
	end
end)

  

  

    
 


    
   

