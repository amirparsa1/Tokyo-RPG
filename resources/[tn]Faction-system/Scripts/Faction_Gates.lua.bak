local JailGates = {}

for i=1 , #JailGatesTable do
	JailGates[i] = createObject ( JailGatesTable[i][1], JailGatesTable[i][2], JailGatesTable[i][3], JailGatesTable[i][4] )
	setElementRotation(JailGates[i], JailGatesTable[i][8], JailGatesTable[i][9], JailGatesTable[i][10])
	setElementInterior ( JailGates[i], JailGatesTable[i][11] )
	
	addCommandHandler("oj",function(thePlayer, cmd)
		if tonumber(getElementData(accSys:getPlayerAcc(thePlayer), "pMember")) == 3 then
			local X, Y, Z = getElementPosition(thePlayer)
			if tonumber(getDistanceBetweenPoints3D( X, Y, Z, JailGatesTable[i][2], JailGatesTable[i][3], JailGatesTable[i][4] )) < JailGatesTable[i][12] then
				moveObject( JailGates[i], 1500, JailGatesTable[i][5], JailGatesTable[i][6], JailGatesTable[i][7] )
				triggerClientEvent("PrisonGateSound", resourceRoot, JailGates[i])
				setTimer( function()
					moveObject( JailGates[i], 1500, JailGatesTable[i][2], JailGatesTable[i][3], JailGatesTable[i][4] )
				end, 5000, 1)
			end
		end
	end)
