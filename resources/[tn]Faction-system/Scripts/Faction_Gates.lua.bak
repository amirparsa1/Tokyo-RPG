	{ 971, -4.59961, -268.7998, 8, -4.59961, -268.7998, -2, 0, 0, 0, 0, 3 },--NG Gate 2
	{ 980, -489.20001, -562.70001, 27.3, -489.20001, -562.70001, 17.3, 0, 0, 180, 0, 5 },--Hitman Gate
	--{ 980, 1142, -1291.9004, 14.3, 1142, -1291.9004, 1.3, 0, 0, 180, 0, 4 },--Hitman Gate
	{ 980, 777.69922, -1330.09961, 13, 777.69922, -1330.09961, 1, 0, 0, 180, 0, 7 },--Nr LS
	{ 980, 1206.3, -1424, 15, 1206.3, -1424, 5, 0, 0, 90, 0, 8 },--Mechanic Garage
	{ 980, 321, -1188.5, 78.1, 321, -1188.5, 65, 0, 0, 38, 0, 11 },--Richman
