--{ GateID, X1, Y1, Z1, X2, Y2, Z2, RotX, RotY, Rotz, INT, Faction },

local Gates = {}
local Cols = {}

for i=1 , #GatesDefault do
	Gates[i] = createObject ( GatesDefault[i][1], GatesDefault[i][2], GatesDefault[i][3], GatesDefault[i][4] )
	setElementRotation(Gates[i], GatesDefault[i][8], GatesDefault[i][9], GatesDefault[i][10])
	setElementInterior ( Gates[i], GatesDefault[i][11] )
	Cols[i] = createColCircle ( GatesDefault[i][2], GatesDefault[i][3] ,6)
	
	addEventHandler( "onColShapeHit", Cols[i],
	function (thePlayer)
		if (thePlayer and getElementType(thePlayer) == "player") then
			if tonumber(getElementData(accSys:getPlayerAcc(thePlayer), "pMember")) == 1 or tonumber(getElementData(accSys:getPlayerAcc(thePlayer), "pMember")) == 2 or tonumber(getElementData(accSys:getPlayerAcc(thePlayer), "pMember")) == 3 or tonumber(getElementData(accSys:getPlayerAcc(thePlayer), "pMember")) == tonumber(GatesDefault[i][12])  then
				moveObject(Gates[i], 6000, GatesDefault[i][5], GatesDefault[i][6], GatesDefault[i][7])
				--triggerClientEvent("OpenGateSound", resourceRoot, Gates[i])
				setTimer(
				function()
					--triggerClientEvent("CloseGateSound", resourceRoot, Gates[i])
					moveObject(Gates[i], 6000, GatesDefault[i][2], GatesDefault[i][3], GatesDefault[i][4])
				end, 90000, 1)
			end
		end
	end)
	
	addEventHandler( "onColShapeLeave", Cols[i],
	function (thePlayer)
		--triggerClientEvent("CloseGateSound", resourceRoot, Gates[i])
		moveObject(Gates[i], 6000, GatesDefault[i][2], GatesDefault[i][3], GatesDefault[i][4])
	end)
	
end
