function givejetpackvip()
    if ( doesPedHaveJetPack(source) ) then
        outputChatBox("#ff0000✖️ #00ff00Shoma #FFFF00VIP #00ff00JetPack Khod Ra #ff0000Destroy #00ff00Kardid!", source, 255, 255, 255, true)
        removePedJetPack(source)
    else
        outputChatBox("#00ff00☑️ Shoma Ba Movafaghiat Savare #FFFF00VIP #00ff00JetPack Shodid!", source, 255, 255, 255, true)
        givePedJetPack(source)
    end
end
addEvent( "givejetpackvip",true)
addEventHandler( "givejetpackvip",root,givejetpackvip )

veh = {}
addEvent("vehcar", true)
addEventHandler("vehcar",root,
function()
    
    --if veh[source] and isElement( veh[source] ) then destroyElement( veh[source] ) 
    --    veh[source] = nil 
    --end
    if veh[source] == null then
        outputChatBox("#00ff00☑️ Mashin #FFFF00VIP #00ff00Shoma Amade Shod!", source, 255, 255, 255, true)
        veh[source] = true
        local x,y,z = getElementPosition(source)
        veh[source] = createVehicle(562, x,y,z)
        setVehicleHandling (veh[source], "mass", 1650.0)
        setVehicleHandling(veh[source], "numberOfGears", 5)
        setVehicleHandling(veh[source], "maxVelocity", 270.0)
        setVehicleHandling(veh[source], "engineAcceleration", 25.0 )
        setVehicleHandling(veh[source], "tractionMultiplier", 1.1)
        setVehicleHandling(veh[source], "tractionLoss", 1)
        setVehicleHandling(veh[source], "engineInertia", 7)
        setVehicleHandling(veh[source], "collisionDamageMultiplier", 0.3)
        setVehicleHandling(veh[source], "dragCoeff", 1.75 )
        setVehicleHandling(veh[source], "driveType", "awd")
        setVehicleHandling(veh[source], "turnMass", 2300)
        setVehicleHandling(veh[source], "brakeDeceleration", 20.0)
        setVehicleHandling(veh[source], "brakeBias", 0.8)
        warpPedIntoVehicle (source,veh[source])
    else
        outputChatBox("#ff0000✖️ #00ff00Mashin #FFFF00VIP #00ff00Shoma #ff0000Destroy #00ff00Shod!", source, 255, 255, 255, true)
        destroyElement( veh[source] )
        veh[source] = null
    end
end)




