gun = {}
addEvent("givegunvip", true)
addEventHandler("givegunvip",root,
function()
    if gun[source] == null then
        gun[source] = true
        giveWeapon ( source, 31, 9999 )
        giveWeapon ( source, 34, 9999 )
        giveWeapon ( source, 28, 9999 )
        giveWeapon ( source, 27, 9999 )
        giveWeapon ( source, 24, 9999 )
        giveWeapon ( source, 23, 9999 )
        outputChatBox("#00ff00☑️ Gun Haye #FFFF00VIP #00ff00Shoma Amade Ba Movafaghiat Be Shoma Dade Shod!", source, 255, 255, 255, true)
    else
        takeAllWeapons (source)
        outputChatBox("#ff0000✖️ #00ff00Shoma #FFFF00VIP #00ff00Gun Ra Haye Khod Ra #ff0000Destroy #00ff00Kardid!", source, 255, 255, 255, true)
        gun[source] = null
    end

end)




function skinvipser()
    skinesh = getElementModel(source)
    if skinesh == 17 then
        
        outputChatBox("#ff0000✖️ #00ff00Skin #FFFF00VIP #00ff00Roye Shoma #ff0000Set #00ff00Hast!", source, 255, 255, 255, true)
    else

        setElementModel ( source, 17 )
        outputChatBox("#00ff00☑️Skin #FFFF00VIP #00ff00Shoma Emal Shod!", source, 255, 255, 255, true)

    end
end
addEvent( "skinvipser",true)
addEventHandler( "skinvipser",root,skinvipser )