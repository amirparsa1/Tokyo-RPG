addCommandHandler("setvip",
function ( thePlayer, command, player, time )
--if (getElementType(thePlayer) == "player") then
    if getPlayerSerial(thePlayer) == "11056965D2EF78959718CB70EC8F8493" or getPlayerSerial(thePlayer) == "A8C802B0C19EBFECF3DF93CFE83906B2" or getPlayerSerial(thePlayer) == "2B129BD8ECFA3E3AB85F037DEE324743" then
		local find = miscSys:findPlayer ( player )
		if player then
		if find then
            if time then
			    local targetPlayer = getPlayerName ( find )
                vipsh =  tonumber(getElementData(accSys:getPlayerAcc(find), "pVip"))
			    setElementData(accSys:getPlayerAcc(find), "pVip", vipsh + time)
			    outputChatBox("#00ff00☑️ #ffffffShoma Be Player#00ff00"..targetPlayer.." #FFFFFF"..time.." Saat Vip Dadid", thePlayer, 0, 255, 0,true)
			    outputChatBox("#ff0000Shoma Az Taraf "..getPlayerName(thePlayer).." Be Modate "..time.." Saat Vip Gereftid Shoma Alan "..vipish.." Saat Vip Darid!", find, 0, 255, 0, true)
			    outputDebugString("Admin "..getPlayerName(thePlayer).." Player "..targetPlayer.." Ra Az Rank'e Admin Kharej Kard!")
                

                
            else
                outputChatBox("#ff0000✖️ #ffffffTime Vared Nashode!", thePlayer, 255, 255, 255, true)
            end


		else
			outputChatBox("#ff0000✖️ #ffffffPlayer Peyda Nashod!", thePlayer, 255, 255, 255, true)
		end
		else
			outputChatBox("#C0C0C0Bezan: /setvip <PartOfName/ID> <VIPTIME>", thePlayer, 255, 22, 22, true)
		end
	end
--end
end)
addCommandHandler("myvip",
function(thplayer)
    
    vipsh =  getElementData(accSys:getPlayerAcc(thplayer), "pVip")
    outputChatBox("#ff0000Shoma "..vipsh.." Saat Vip Darid!", thplayer, 0, 255, 0, true)

end)

function openvippanel(thePlayer,matchingDimension)
    if tonumber(getElementData(accSys:getPlayerAcc(thePlayer), "pVip")) > 0 then
	    triggerClientEvent("showvippanel", thePlayer, thePlayer)
    end
end
addCommandHandler("ovp",openvippanel)




