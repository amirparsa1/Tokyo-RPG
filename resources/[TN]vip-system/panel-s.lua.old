function vhidme()

    if getElementData(source,"inKermRizi") == false then
        outputChatBox("#00ff00☑️ Shoma Ba Movafaghiat Hide Shodid!", source, 255, 255, 255, true)
        setElementAlpha(source,0)
        setElementData(source,"invis",true)
        setElementData(source,"inKermRizi",true)
        guiSetProperty(vippanel, "Visible", "False")
        showCursor(false)
        setSoundVolume(sound,0.9)
    elseif getElementData(source,"inKermRizi") == true then
        outputChatBox("#ff0000✖️ #00ff00Shoma Az Halate #FFFF00VIP #00ff00Hide #ff0000Kharej #00ff00Shodid!", source, 255, 255, 255, true)
        setElementAlpha(source,255)
        setElementData(source,"invis",false)
        setElementData(source,"inKermRizi",false)
        
    end

end
addEvent( "hideshkon",true)
addEventHandler( "hideshkon",root,vhidme )


